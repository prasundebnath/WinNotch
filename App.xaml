<Application x:Class="WinNotch.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/NotchWindow.xaml"
             ShutdownMode="OnExplicitShutdown">

    <Application.Resources>
        <!-- =====================================================
             GLOBAL RESOURCE DICTIONARY
             Apple-inspired color tokens and shared styles
        ===================================================== -->
        <ResourceDictionary>

            <!-- Core color palette (iPhone Dynamic Island inspired) -->
            <Color x:Key="NotchBlack">#FF0A0A0A</Color>
            <Color x:Key="NotchSurface">#FF141414</Color>
            <Color x:Key="NotchBorder">#FF2A2A2A</Color>
            <Color x:Key="TextPrimary">#FFFFFFFF</Color>
            <Color x:Key="TextSecondary">#FF9A9A9A</Color>
            <Color x:Key="AccentBlue">#FF0A84FF</Color>

            <SolidColorBrush x:Key="NotchBlackBrush" Color="{StaticResource NotchBlack}"/>
            <SolidColorBrush x:Key="NotchSurfaceBrush" Color="{StaticResource NotchSurface}"/>
            <SolidColorBrush x:Key="NotchBorderBrush" Color="{StaticResource NotchBorder}"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
            <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}"/>

            <!-- Shared corner radius for rounded bottom edges -->
            <CornerRadius x:Key="NotchCornerRadius">0,0,20,20</CornerRadius>
            <CornerRadius x:Key="AlbumArtCornerRadius">8,8,8,8</CornerRadius>

        </ResourceDictionary>
    </Application.Resources>

</Application>
