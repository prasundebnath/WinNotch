<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target Windows 10/11 with WPF -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WinNotch</AssemblyName>
    <RootNamespace>WinNotch</RootNamespace>
    <!-- Required to use Windows.Media.Control (UWP interop) -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Enables access to Windows Runtime APIs from .NET -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Embed the app icon as a resource -->
  <ItemGroup>
    <None Update="Assets\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
